# Development build: not a Chromium official build, and static, with DCHECKs, so an embedder-only change compiles and
# links only the embedder. Release builds use release.gn; contract tests must also pass there.
is_debug = false
is_official_build = false
is_component_build = false
dcheck_always_on = true
symbol_level = 1
blink_symbol_level = 0
v8_symbol_level = 0
use_remoteexec = false
root_extra_deps = [ "//lanescape_browser" ]

# Redistribution terms: third_party/README.md.
proprietary_codecs = false
ffmpeg_branding = "Chromium"
