# Release build: ThinLTO, CFI and PGO, as production Chromium. Contract tests must also pass here,
# since CFI checks calls across the host boundary that a development build never does.
is_debug = false
is_official_build = true
is_component_build = false
dcheck_always_on = false
symbol_level = 1
blink_symbol_level = 0
v8_symbol_level = 0
use_remoteexec = false
root_extra_deps = [ "//lanescape_browser" ]

# Redistribution terms: third_party/README.md.
proprietary_codecs = false
ffmpeg_branding = "Chromium"
